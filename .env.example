# Copy to .env and fill in. .env is gitignored and never enters the image.
# deploy.sh copies these to Railway over stdin. They are never printed.

ANTHROPIC_API_KEY=
# Only needed when the key is identity-linked rather than workspace-scoped. The SDK does
# not read this on its own; the client sends it as a default header when it is set.
ANTHROPIC_WORKSPACE_ID=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# One project per build. deploy.sh falls back to the folder name when this is blank.
LANGSMITH_PROJECT=
