# Per-project names for deploy.sh, finish.sh and run_local.sh. Copy to deploy.env and fill in.
# No secrets go here. Secrets live in .env. This file is safe to commit.
#
# Every line is optional. Leave one out and the script uses the default shown.

# Names on GitHub and Railway. Default: this folder's name, lowercased, odd characters
# turned into dashes.
APP_NAME=
REPO_NAME=
PROJECT=
SERVICE=api

# Python packages, module form. What run_local.sh and the Dockerfile call.
API_MODULE=app.api.run
INGEST_MODULE=app.ingest.run

# Where the Vite front end lives.
WEB_DIR=web

# The environment variable names the API reads for allowed origins and the internal
# token. Must match config.py exactly, or CORS and the token gate silently do nothing.
ORIGINS_VAR=APP_ALLOWED_ORIGINS
TOKEN_VAR=APP_INTERNAL_TOKEN

# Routes. HEALTH_PATH must return 200 when the app is ready. PROBE_PATH is any route the
# app serves; a 4xx from it proves uvicorn is up. INTERNAL_PATH is a token-gated route to
# verify after deploy, or empty to skip the token checks.
HEALTH_PATH=/health
PROBE_PATH=/health
INTERNAL_PATH=/internal/selfcheck

# Keys that must be non-empty in .env, space separated. Each one is copied to Railway.
REQUIRED_KEYS="ANTHROPIC_API_KEY LANGSMITH_API_KEY"

# Words for humans.
COMMIT_MSG="first deploy"
DEMO_HINT="Ask it something the corpus can answer and check the citation."
BUILD_MINUTES=4-5
