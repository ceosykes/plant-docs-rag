# Per-project names for deploy.sh, finish.sh and run_local.sh. No secrets here.
APP_NAME=plant-docs-rag
REPO_NAME=plant-docs-rag
PROJECT=plant-docs-rag
SERVICE=api
API_MODULE=app.api.run
INGEST_MODULE=app.ingest.run
WEB_DIR=web
ORIGINS_VAR=APP_ALLOWED_ORIGINS
TOKEN_VAR=APP_INTERNAL_TOKEN
HEALTH_PATH=/health
PROBE_PATH=/health
INTERNAL_PATH=/internal/selfcheck
REQUIRED_KEYS="ANTHROPIC_API_KEY ANTHROPIC_WORKSPACE_ID LANGSMITH_API_KEY"
COMMIT_MSG="plant docs rag, first deploy"
DEMO_HINT="Ask: the pump seal is leaking, can I open it while it runs?"
BUILD_MINUTES=4-5
API_PORT=8022
